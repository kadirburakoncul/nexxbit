{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=nexxbitDB;Uid=CHANGE_ME;Pwd=CHANGE_ME;",
    "Redis": ""
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_USE_AT_LEAST_32_CHARACTER_SECRET_KEY_HERE",
    "Issuer": "Nexxbit",
    "Audience": "Nexxbit",
    "ExpiryMinutes": "15"
  },
  "Encryption": {
    "MasterKey": "CHANGE_ME_BASE64_32_BYTE_KEY_HERE="
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/nexxbit-.log", "rollingInterval": "Day" } }
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      },
      {
        "Endpoint": "*/api/auth/login",
        "Period": "5m",
        "Limit": 10
      },
      {
        "Endpoint": "*/api/auth/register",
        "Period": "1h",
        "Limit": 5
      },
      {
        "Endpoint": "*/api/auth/forgot-password",
        "Period": "1h",
        "Limit": 5
      },
      {
        "Endpoint": "*/api/auth/reset-password",
        "Period": "15m",
        "Limit": 5
      },
      {
        "Endpoint": "*/api/auth/verify-login-otp",
        "Period": "5m",
        "Limit": 10
      }
    ]
  },
  "Email": {
    "From": {
      "Address": "CHANGE_ME@gmail.com",
      "Name": "Nexxbit"
    },
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": "587",
      "Username": "CHANGE_ME@gmail.com",
      "Password": "CHANGE_ME_GMAIL_APP_PASSWORD"
    }
  },
  "Frontend": {
    "BaseUrl": "https://nexxbit.com.tr"
  },
  "AllowedHosts": "*"
}
